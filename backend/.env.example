# Local development
PROJECT_NAME=Blackletter
VERSION=0.2.4
DEBUG=true
REQUIRE_SECURITY_GATE=false

# Required integrations
COURTLISTENER_API_KEY=replace_me
TOGETHER_API_KEY=replace_me

# Model and bounded completion settings
LLM_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-0731
